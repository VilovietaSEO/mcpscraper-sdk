{
  "name": "mcpscraper-sdk-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Public client SDKs and API contracts for mcpscraper.dev and memory.mcpscraper.dev",
  "workspaces": [
    "packages/memory",
    "packages/scraper",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:contract-projection": "node --test --import tsx tests/mcp-contract-telemetry.test.ts tests/update-mcp-manifest.test.ts tests/update-memory-manifest.test.ts tests/gmail-contract.test.ts tests/xray-journey-contract.test.ts tests/xray-attribution-contract.test.ts tests/personal-assistant-contract.test.ts",
    "test:python": "node scripts/run-python-project.mjs packages/scraper-python -m pytest packages/scraper-python/tests && node scripts/run-python-project.mjs packages/memory-python -m pytest packages/memory-python/tests",
    "validate-contracts": "node --import tsx scripts/validate-contracts.ts",
    "check:product-contract": "node --import tsx scripts/check-public-product-contract.ts",
    "smoke-test": "node --import tsx scripts/smoke-test.ts",
    "generate:memory": "node --import tsx scripts/generate-memory-client.ts && python3 packages/memory-python/scripts/generate_models.py",
    "update:memory-contract": "node --import tsx scripts/update-memory-manifest.ts",
    "update:mcp-contract": "node --import tsx scripts/update-mcp-manifest.ts",
    "verify:mcp-source-contract": "node --import tsx scripts/check-mcp-source-contract.ts",
    "generate:mcp": "node --import tsx scripts/generate-mcp-client.ts && node scripts/run-python-project.mjs packages/scraper-python scripts/generate-mcp-python.py",
    "verify:parity": "npm run build --workspace=mcpscraper-memory-sdk && node --import tsx scripts/verify-sdk-parity.ts && node scripts/run-python-project.mjs packages/scraper-python scripts/verify_sdk_parity.py",
    "example:gmail": "npm run build --workspace=mcpscraper-memory-sdk && node examples/gmail-complete-workflow.mjs",
    "example:gmail:bulk-manage": "npm run build --workspace=mcpscraper-memory-sdk && node examples/gmail-bulk-manage.mjs",
    "example:xray:journeys": "npm run build --workspace=mcpscraper-memory-sdk && node examples/xray-journeys.mjs",
    "example:xray:attribution": "npm run build --workspace=mcpscraper-memory-sdk && node examples/xray-attribution.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "json-schema-to-typescript": "^15.0.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "agent-base": "^7.1.4",
    "ansi-colors": "^4.1.3",
    "any-promise": "^1.3.0",
    "argparse": "^2.0.1",
    "balanced-match": "^1.0.2",
    "brace-expansion": "^2.1.4",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "change-case": "^5.4.4",
    "chokidar": "^4.0.3",
    "colorette": "^1.4.0",
    "commander": "^12.1.0",
    "confbox": "^0.1.8",
    "consola": "^3.4.2",
    "debug": "^4.4.3",
    "esbuild": "^0.28.1",
    "fast-deep-equal": "^3.1.3",
    "fdir": "^6.5.0",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "fsevents": "^2.3.3",
    "https-proxy-agent": "^7.0.6",
    "index-to-position": "^1.2.0",
    "is-extglob": "^2.1.1",
    "is-glob": "^4.0.3",
    "joycon": "^3.1.1",
    "js-levenshtein": "^1.1.6",
    "js-tokens": "^4.0.0",
    "js-yaml": "^4.3.1",
    "json-schema-traverse": "^1.0.0",
    "lilconfig": "^3.1.3",
    "lines-and-columns": "^1.2.4",
    "load-tsconfig": "^0.2.5",
    "lodash": "^4.18.1",
    "magic-string": "^0.30.21",
    "mcpscraper-cli": "^0.38.0",
    "mcpscraper-memory-sdk": "^0.39.0",
    "mcpscraper-sdk": "^0.39.0",
    "minimatch": "^5.1.9",
    "minimist": "^1.2.8",
    "mlly": "^1.8.2",
    "ms": "^2.1.3",
    "mz": "^2.7.0",
    "object-assign": "^4.1.1",
    "openapi-typescript": "^7.13.0",
    "parse-json": "^8.3.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pirates": "^4.0.7",
    "pkg-types": "^1.3.1",
    "pluralize": "^8.0.0",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.6",
    "readdirp": "^4.1.2",
    "require-from-string": "^2.0.2",
    "resolve-from": "^5.0.0",
    "rollup": "^4.62.2",
    "source-map": "^0.7.6",
    "sucrase": "^3.35.1",
    "supports-color": "^10.2.2",
    "thenify": "^3.3.1",
    "thenify-all": "^1.6.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tree-kill": "^1.2.2",
    "ts-interface-checker": "^0.1.13",
    "type-fest": "^4.41.0",
    "ufo": "^1.6.4",
    "undici-types": "^6.21.0",
    "uri-js-replace": "^1.0.1",
    "yaml-ast-parser": "^0.0.43",
    "yargs-parser": "^21.1.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
